# API Gateway & Frontend
VITE_API_URL="http://localhost:80"

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexora_master
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/nexora_master

# Cache & Message Broker
REDIS_URL=redis://redis:6379/0

# Authentication
JWT_SECRET=supersecretkey-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Services Discovery (Internal Docker Network)
AUTH_SERVICE_URL=http://auth_service:8000
PROFILE_SERVICE_URL=http://profile_service:8000
MATCHMAKING_SERVICE_URL=http://matchmaking_service:8000
BATTLE_ENGINE_URL=http://battle_engine_service:8000
REALTIME_SERVICE_URL=http://realtime_service:8000

# Storage
MEDIA_ROOT=/app/uploads

